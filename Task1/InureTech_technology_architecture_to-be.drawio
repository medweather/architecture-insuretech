        <mxCell id="core_d" parent="1" style="fillColor=#ffffff;strokeColor=#ff5958;html=1;whiteSpace=wrap;fontFamily=Arial;rounded=0;fontSize=11;align=center;verticalAlign=middle;" value="&lt;b&gt;core-app&lt;/b&gt;" vertex="1">
