        <mxCell id="agg_d" parent="1" style="fillColor=#ffffff;strokeColor=#ff5958;html=1;whiteSpace=wrap;fontFamily=Arial;rounded=0;fontSize=11;align=center;verticalAlign=middle;" value="&lt;b&gt;ins-product-aggregator&lt;/b&gt;" vertex="1">
